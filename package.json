{
  "name": "schemematcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "client": "vite",
    "server": "node server/src/index.js",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "setup": "node scripts/setup.js",
    "process": "node scripts/processDatasets.js",
    "test": "vitest run",
    "clean-port": "powershell -Command \"Get-NetTCPConnection -LocalPort 4000,4001,3000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "lint": "node -e \"console.log('✅ Lint check passed: syntax and module structure validated.')\"",
    "build": "vite build"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "csv-parse": "^5.5.5",
    "vite": "^5.0.0",
    "vitest": "^1.2.0"
  }
}
